{
  "name": "persian-shop-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --watch-path=src --watch-path=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "migrate": "node --env-file-if-exists=.env src/migrate.mjs",
    "test": "node --env-file-if-exists=.env --test test/*.test.mjs",
    "setup": "node --env-file-if-exists=.env src/setup-db.mjs",
    "check": "node --env-file-if-exists=.env src/check-db.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "nodemailer": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
